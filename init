#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
hostname netapp-ram-test
dmesg -n 3
echo 'NETAPP_LINUX_RAM_SHELL_READY'
uname -a
cat /proc/cmdline
echo 'RAM-only test shell. No storage mounts, installer, network setup or automatic module loading.'
while true; do
    setsid cttyhack sh </dev/console >/dev/console 2>&1
    sleep 1
done
